---
// Page du jeu : tant que le pilote n'est pas produit, elle dit ce qui sera
// publié ici et où en est la production (tableau du README).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { avancement } from '../data/projet';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}/${p}`;
const pilote = avancement().find((e) => /pilote/i.test(e.livrable));

const livrables = [
	{ t: 'Le jeu dans le navigateur', d: 'Jouable sur ce site, sans compte ni serveur. La progression reste dans votre navigateur.' },
	{ t: 'Le paquet pour Moodle', d: 'Le même jeu, empaqueté en SCORM pour le cours Moodle 4.5 : l’avancement et le score sont transmis à Moodle.' },
	{ t: 'Les textes des séquences', d: 'La voix de la copie, les feedbacks, les diapositives « L’essentiel » et les scripts audio, repris des documents de conception.' },
];
---

<StarlightPage
	frontmatter={{
		title: 'Jouer',
		description: 'Où et comment jouer à « Copie conforme ? », et ce qui sera publié ici.',
	}}
>
	<div class="banner">
		<span class="dot" aria-hidden="true"></span>
		<div>
			<strong>Le jeu n’est pas encore jouable.</strong>
			<span>
				Prochaine étape : {pilote ? pilote.livrable.toLowerCase() : 'le pilote'} ({pilote ? pilote.etat.toLowerCase() : 'à venir'}). Il sera
				publié ici dès sa production, avant le test avec des enseignants volontaires.
			</span>
		</div>
	</div>

	<h2>Ce qui sera publié ici</h2>
	<p>
		Le jeu est développé d’abord ici, sur le dépôt, puis installé sur Moodle. Le dépôt publiera de quoi jouer et de quoi réutiliser le jeu :
	</p>
	<ul class="liv">
		{
			livrables.map((l) => (
				<li>
					<strong>{l.t}</strong>
					<span>{l.d}</span>
				</li>
			))
		}
	</ul>

	<h2>En attendant</h2>
	<ul>
		<li>
			Lire le <a href={u('conception/scenario-detaille/')}>scénario détaillé</a> : chaque scène y est écrite, avec la voix de la copie, les
			épreuves et leurs feedbacks.
		</li>
		<li>
			Suivre le <a href={u('journal/')}>journal de conception</a>, qui date chaque étape.
		</li>
		<li>
			Lire les <a href="https://jediopenlab.hypotheses.org/">billets du carnet JEDI-OpenLab</a> dont le jeu est tiré.
		</li>
	</ul>
</StarlightPage>

<style>
	.banner {
		display: flex;
		gap: 0.9rem;
		align-items: flex-start;
		padding: 1rem 1.25rem;
		border-radius: 0.75rem;
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-gray-1);
	}
	.banner div {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.banner strong {
		color: var(--sl-color-white);
	}
	.dot {
		flex-shrink: 0;
		margin-top: 0.45rem;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--sl-color-accent);
	}
	.liv {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}
	.liv li {
		display: grid;
		gap: 0.2rem;
		padding: 1rem 1.2rem;
		border-radius: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-bg-nav);
	}
	.liv strong {
		color: var(--sl-color-white);
	}
	.liv span {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
</style>
